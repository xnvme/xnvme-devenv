# The host half of a release: nosi's ubuntu-2604-docker, which has stock QEMU
# and cijoe, with the vfio-user servers from lock.toml installed. Built by
# `make host`, which fetches and checks the debs into host/debs first.
ARG BASE
FROM ${BASE}
COPY debs/ /tmp/debs/
RUN apt-get -qy update \
 && DEBIAN_FRONTEND=noninteractive apt-get -qy install --no-install-recommends /tmp/debs/*.deb \
 && rm -rf /tmp/debs /var/lib/apt/lists/*
