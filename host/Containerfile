# The host half of a release: nosi's ubuntu-2604-docker, which has stock QEMU
# and cijoe, with the vfio-user servers from lock.toml installed and this
# repository's cijoe environment under /opt/xnvme-devenv. Built by 'make host',
# from the repository's root, after cijoe has fetched and checked the debs.
ARG BASE
FROM ${BASE}
COPY host/debs/ /tmp/debs/
RUN apt-get -qy update \
 && DEBIAN_FRONTEND=noninteractive apt-get -qy install --no-install-recommends /tmp/debs/*.deb doxygen fontconfig fonts-dejavu-core graphviz mdadm ovmf pigz swtpm universal-ctags \
 && rm -rf /tmp/debs /var/lib/apt/lists/*
# xNVMe's source checks and packaging, as its CI runs them in this container:
# the formatters and linters its pre-commit calls, the man-page generators and
# the Debian packaging tools
RUN apt-get -qy update \
 && DEBIAN_FRONTEND=noninteractive apt-get -qy install --no-install-recommends autotools-dev build-essential cargo clang-format debhelper devscripts dh-make dh-python lintian pre-commit rustfmt shellcheck sudo txt2man \
 && rm -rf /var/lib/apt/lists/* \
 && pipx install --global kmdo \
 && pipx install --global poetry
COPY cijoe/ /opt/xnvme-devenv/cijoe/
COPY rigs/ /opt/xnvme-devenv/rigs/
# The package, with the cijoe it pins; an image without a tool the
# environments rely on is never published. Global, as the base's own cijoe is,
# so the pinned one takes over /usr/local/bin/cijoe; a user install lands in
# ~/.local/bin, which is not on PATH, and leaves the base's cijoe running
RUN pipx install --global /opt/xnvme-devenv/cijoe --include-deps --force \
 && cd /opt/xnvme-devenv/cijoe \
 && cijoe tasks/host-check.yaml --config configs/host-check.toml --config configs/host-tools.toml \
    --monitor --report-skip --output /tmp/host-check \
 && rm -rf /tmp/host-check
