#!/bin/sh
# Qualify an xnvme-images guest from inside it: its rocjitsu GPU and its kernel.
#
#   rocjitsu-guest-check gemm          FP32 GEMM on the GPU, checked on the CPU
#   rocjitsu-guest-check p2p [ibdev]   RDMA into and out of VRAM on a NIC
#   rocjitsu-guest-check iouring-dmabuf <blockdev>
#                                      io_uring I/O through a dma-buf, which
#                                      needs the guest's own kernel
#   rocjitsu-guest-check iouring-vram <blockdev>
#                                      the same, the device DMAing into VRAM
#
# Each test is compiled on first use, the HIP ones for gfx1250. All run with
# the hotswap library skipped: Ubuntu's ROCr insists on it for a gfx1250 A0
# agent and fails hsa_init without it, and nothing ships it.
#
# A test still running after ROCJITSU_CHECK_TIMEOUT seconds (600) has hung
# rather than slowed, as a process does whose queues KFD evicted and never got
# back; it is killed and fails, after the eviction counters and the kernel log
# are printed for whoever reads why.
#
# p2p passing shows the bytes are right, not where they went; the NIC's
# server says that, for rocm-ernic in its "peer memory ... served DMA" line.
set -eu
src=/usr/share/rocjitsu-guest-tests
cache=${XDG_CACHE_HOME:-$HOME/.cache}/rocjitsu-guest-tests
mkdir -p "$cache"

build() {
	name=$1
	shift
	if [ -f "$src/$name.c" ]; then
		[ "$cache/$name" -nt "$src/$name.c" ] && return
		set -- cc -o "$cache/$name" "$src/$name.c" "$@"
	else
		[ "$cache/$name" -nt "$src/$name.hip" ] && return
		set -- hipcc --offload-arch=gfx1250 -o "$cache/$name" "$src/$name.hip" "$@"
	fi
	"$@" 2>"$cache/$name.log" || {
		cat "$cache/$name.log" >&2
		exit 1
	}
}

# Runs a test under the deadline; the exit status is the test's, or 124
run() {
	"$@" &
	pid=$!
	left=${ROCJITSU_CHECK_TIMEOUT:-600}
	while kill -0 "$pid" 2>/dev/null; do
		if [ "$left" -le 0 ]; then
			echo "rocjitsu-guest-check: $1 hung; KFD eviction counters, then the kernel log:" >&2
			grep -H . /sys/class/kfd/kfd/proc/*/stats_*/evicted_ms >&2 || true
			dmesg | tail -n 60 >&2 || true
			kill -9 "$pid"
			wait "$pid" || true
			return 124
		fi
		sleep 1
		left=$((left - 1))
	done
	wait "$pid"
}

export HSA_HOTSWAP_DISABLE=1
case "${1:-}" in
gemm)
	build sgemm
	run "$cache/sgemm"
	;;
p2p)
	build rdma_p2p -libverbs -lhsa-runtime64
	shift
	run "$cache/rdma_p2p" "$@"
	;;
iouring-dmabuf)
	build iouring_dmabuf -luring
	shift
	run "$cache/iouring_dmabuf" "$@"
	;;
iouring-vram)
	build iouring_vram -luring -lhsa-runtime64
	shift
	run "$cache/iouring_vram" "$@"
	;;
*)
	sed -n '4,10s/^#   //p' "$0" >&2
	exit 2
	;;
esac
